{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4da9b999-35b7-498f-b32c-b09a4213e145","database_name": "nova2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "5fb38a350abe4cacae6a877450749414" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
